.menu-btn {
    width: 260px;
    height: 44px;
    margin-bottom: 12px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(127, 233, 255, 0.55);
    border-radius: 6px;
    background-color: rgba(10, 20, 26, 0.7);
    color: rgb(127, 233, 255);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.menu-btn:hover {
    background-color: rgba(127, 233, 255, 0.12);
    border-color: rgb(127, 233, 255);
}

.menu-btn:focus {
    background-color: rgba(127, 233, 255, 0.18);
    border-color: rgb(127, 233, 255);
}

.menu-btn:disabled {
    border-color: rgba(127, 233, 255, 0.2);
    color: rgba(127, 233, 255, 0.35);
    background-color: rgba(10, 20, 26, 0.4);
}
