.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Orbitron/Orbitron-Regular%20SDF.ttf?fileID=12800000&guid=362601a4043a3254388ca3ba9b3358af&type=3#Orbitron-Regular SDF");
    color: rgb(127, 233, 255);
}

.ship-btn {
    position: absolute;
    top: 26px;
    left: 28px;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px 6px 8px;
    border-width: 1px;
    border-color: rgba(127, 233, 255, 0.55);
    border-radius: 8px;
    background-color: rgba(127, 233, 255, 0.06);
}

.ship-btn:hover {
    border-color: rgba(127, 233, 255, 0.85);
    background-color: rgba(127, 233, 255, 0.12);
}

.ship-btn:active {
    background-color: rgba(127, 233, 255, 0.2);
}

.ship-btn__title {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}

.ship-btn__sub {
    font-size: 9px;
    letter-spacing: 1.5px;
    color: rgb(127, 233, 255);
    margin-top: 1px;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/ShareTechMono/ShareTechMono-Regular%20SDF.ttf?fileID=12800000&guid=7fee49d8fbac016489f46f913649c73b&type=3#ShareTechMono-Regular SDF");
}

.pilot__avatar {
    font-size: 20px;
    margin-right: 8px;
    color: rgba(127, 233, 255, 0.85);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/InfinityIconsHU/Infinity-Icons-HU.otf?fileID=12800000&guid=7ce3ec5a2b4c0374e809c27570342a60&type=3#Infinity-Icons-HU");
}

.sector {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.sector__rule {
    width: 20px;
    height: 1px;
    background-color: rgb(127, 233, 255);
    margin: 0 10px;
}

.sector__name {
    font-size: 15px;
    letter-spacing: 6px;
    color: rgb(127, 233, 255);
}

.sector__time {
    font-size: 15px;
    letter-spacing: 6px;
    color: rgb(127, 233, 255);
}

.sector__time--warning {
    color: rgb(255, 90, 90);
}

.sector-progress {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
}

.sector-progress__status {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(127, 233, 255, 0.8);
    margin-bottom: 4px;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/ShareTechMono/ShareTechMono-Regular%20SDF.ttf?fileID=12800000&guid=7fee49d8fbac016489f46f913649c73b&type=3#ShareTechMono-Regular SDF");
}

.sector-progress__status--ready {
    color: rgb(54, 255, 158);
}

.sector-progress__track {
    width: 160px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(127, 233, 255, 0.12);
    overflow: hidden;
}

.sector-progress__fill {
    width: 0%;
    height: 100%;
    border-radius: 2px;
    background-color: rgb(127, 233, 255);
}

.sector-progress__fill--ready {
    background-color: rgb(54, 255, 158);
}

.gauges {
    position: absolute;
    top: 104px;
    left: 28px;
    flex-direction: row;
}

.dial {
    width: 92px;
    height: 92px;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
}

.dial__val {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: -2px;
}

.dial__label {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/ShareTechMono/ShareTechMono-Regular%20SDF.ttf?fileID=12800000&guid=7fee49d8fbac016489f46f913649c73b&type=3#ShareTechMono-Regular SDF");
}

.dial__label--health {
    color: rgb(54, 255, 158);
}

.dial__label--ammo {
    color: rgb(127, 233, 255);
}

.dial__label--fuel {
    color: rgb(255, 194, 77);
}

.parts {
    position: absolute;
    top: 212px;
    left: 28px;
    flex-direction: row;
    align-items: center;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/ShareTechMono/ShareTechMono-Regular%20SDF.ttf?fileID=12800000&guid=7fee49d8fbac016489f46f913649c73b&type=3#ShareTechMono-Regular SDF");
}

.parts__label {
    font-size: 15px;
    letter-spacing: 2px;
    opacity: 0.7;
    margin-right: 9px;
}

.parts__val {
    font-size: 17px;
    color: rgb(255, 255, 255);
}

.topright {
    position: absolute;
    top: 26px;
    right: 28px;
    align-items: center;
}

.radar-wrap {
    align-items: center;
}

.radar {
    width: 150px;
    height: 150px;
    background-color: rgba(4, 6, 10, 0.55);
    border-radius: 75px;
}

.legend {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 150px;
    margin-top: 8px;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/ShareTechMono/ShareTechMono-Regular%20SDF.ttf?fileID=12800000&guid=7fee49d8fbac016489f46f913649c73b&type=3#ShareTechMono-Regular SDF");
}

.legend__item {
    font-size: 11px;
    margin: 0 4px;
}

.legend__item--you {
    color: rgb(255, 255, 255);
}

.legend__item--hostile {
    color: rgb(255, 90, 90);
}

.legend__item--rock {
    color: rgb(111, 188, 255);
}

.legend__item--portal {
    color: rgb(182, 155, 255);
}

.upgrades {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/ShareTechMono/ShareTechMono-Regular%20SDF.ttf?fileID=12800000&guid=7fee49d8fbac016489f46f913649c73b&type=3#ShareTechMono-Regular SDF");
}

.upgrade {
    flex-direction: row;
    align-items: center;
    margin: 0 17px;
}

.upgrade__label {
    font-size: 15px;
    letter-spacing: 1px;
    margin-right: 9px;
}

.upgrade__pips {
    flex-direction: row;
}

.upgrade__val {
    font-size: 13px;
    color: rgb(255, 255, 255);
}

.pip {
    width: 9px;
    height: 9px;
    margin: 0 2px;
    rotate: 45deg;
}

.pip--on {
    background-color: rgb(127, 233, 255);
}

.pip--off {
    border-width: 1px;
    border-color: rgba(127, 233, 255, 0.5);
}
