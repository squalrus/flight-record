.mission__text {
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 6px;
}

.mission__description {
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
    letter-spacing: 1px;
    white-space: normal;
    margin-top: 8px;
}
