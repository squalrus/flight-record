<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/Panel.uss"/>
    <Style src="project://database/Assets/UI/Mission/Mission.uss"/>
    <ui:VisualElement name="mission" class="modal-overlay mission">
        <ui:VisualElement name="panel" class="panel">
            <ui:VisualElement class="panel__header">
                <ui:Label text="MISSION" class="panel__title"/>
                <ui:Button name="close-btn" text="X" class="close-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="panel__rule"/>
            <ui:Label name="mission-text-val" text="CLEAR THE HOSTILES" class="mission__text"/>
            <ui:Label name="mission-description-val" text="Clear the threats and find the portal." class="mission__description"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
