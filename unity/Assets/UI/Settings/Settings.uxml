<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/Panel.uss"/>
    <Style src="project://database/Assets/UI/Settings/Settings.uss"/>
    <ui:VisualElement name="settings" class="modal-overlay settings">
        <ui:VisualElement name="panel" class="panel">
            <ui:VisualElement class="panel__header">
                <ui:Label text="SETTINGS" class="panel__title"/>
                <ui:Button name="close-btn" text="X" class="close-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="panel__rule"/>
            <ui:VisualElement class="settings-row">
                <ui:Label text="RUMBLE" class="settings-row__label"/>
                <ui:Button name="rumble-toggle-btn" text="ON" class="settings-row__toggle-btn"/>
            </ui:VisualElement>
            <ui:VisualElement name="clear-data-rule" class="panel__rule"/>
            <ui:Button name="clear-data-btn" text="CLEAR SAVED DATA" class="settings-danger-btn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
