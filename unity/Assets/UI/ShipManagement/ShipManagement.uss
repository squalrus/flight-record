.ship-management {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Orbitron/Orbitron-Regular%20SDF.ttf?fileID=12800000&guid=362601a4043a3254388ca3ba9b3358af&type=3#Orbitron-Regular SDF");
    background-color: rgba(0, 0, 0, 0.55);
}

.panel {
    width: 980px;
    padding: 20px;
    border-width: 1px;
    border-color: rgba(127, 233, 255, 0.55);
    border-radius: 10px;
    background-color: rgba(10, 20, 26, 0.92);
    overflow: hidden;
}

.panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.panel__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 12px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}

.close-btn {
    flex-grow: 0;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(127, 233, 255, 0.55);
    border-radius: 4px;
    background-color: rgba(10, 20, 26, 0.7);
    color: rgb(127, 233, 255);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.close-btn:hover {
    background-color: rgba(127, 233, 255, 0.12);
}

.close-btn:focus {
    border-color: rgb(127, 233, 255);
    background-color: rgba(127, 233, 255, 0.18);
}

.close-btn__label {
    margin: 0;
    padding: 0;
    color: rgb(127, 233, 255);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.panel__rule {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 16px;
    background-color: rgba(127, 233, 255, 0.3);
}

.page-indicator {
    color: rgba(127, 233, 255, 0.6);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    flex-grow: 0;
    flex-shrink: 0;
}

.nav-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.nav-row--end {
    justify-content: flex-end;
}

.nav-row--split {
    justify-content: space-between;
}

.nav-row .menu-btn {
    margin-bottom: 0;
    width: 200px;
}

.panel__title-group {
    flex-direction: row;
    align-items: center;
}

.panel__title-parts-label {
    color: rgba(127, 233, 255, 0.6);
    font-size: 13px;
    letter-spacing: 1.5px;
    margin-left: 14px;
    margin-right: 6px;
}

.panel__title-parts {
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(110, 230, 140);
}

.placeholder {
    color: rgba(127, 233, 255, 0.6);
    font-size: 12px;
}

.categories {
    flex-direction: row;
    align-items: flex-start;
}

.category-column {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: 16px;
}

.category-column--divided {
    padding-left: 16px;
    border-left-width: 1px;
    border-left-color: rgba(127, 233, 255, 0.25);
}

.category-label {
    color: rgb(127, 233, 255);
    letter-spacing: 1.5px;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.category-note {
    color: rgba(127, 233, 255, 0.5);
    font-size: 10px;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    white-space: normal;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.stat-row__label {
    color: rgb(127, 233, 255);
    letter-spacing: 1.5px;
    font-size: 13px;
    width: 120px;
}

.stat-row__val {
    flex-grow: 1;
    min-width: 60px;
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
}

.buy-btn {
    width: 108px;
    height: 28px;
    margin: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(127, 233, 255, 0.55);
    border-radius: 6px;
    background-color: rgba(10, 20, 26, 0.7);
    color: rgb(127, 233, 255);
    font-size: 10px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.buy-btn:hover {
    background-color: rgba(127, 233, 255, 0.12);
    border-color: rgb(127, 233, 255);
}

.buy-btn:focus {
    background-color: rgba(127, 233, 255, 0.18);
    border-color: rgb(127, 233, 255);
}

.buy-btn:disabled {
    border-color: rgba(127, 233, 255, 0.2);
    color: rgba(127, 233, 255, 0.35);
    background-color: rgba(10, 20, 26, 0.4);
}
