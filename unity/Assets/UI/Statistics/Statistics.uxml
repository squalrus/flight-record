<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/Panel.uss"/>
    <Style src="project://database/Assets/UI/Statistics/Statistics.uss"/>
    <ui:VisualElement name="statistics" class="modal-overlay statistics">
        <ui:VisualElement name="panel" class="panel">
            <ui:VisualElement class="panel__header">
                <ui:Label text="STATISTICS" class="panel__title"/>
                <ui:Button name="close-btn" text="X" class="close-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="panel__rule"/>
            <ui:VisualElement class="stat-row">
                <ui:Label text="SHOTS FIRED" class="stat-row__label"/>
                <ui:Label name="shots-fired-val" text="0" class="stat-row__val"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="HIT PERCENTAGE" class="stat-row__label"/>
                <ui:Label name="hit-pct-val" text="?" class="stat-row__val"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="POWERUPS COLLECTED" class="stat-row__label"/>
                <ui:Label name="powerups-val" text="?" class="stat-row__val"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="SHIPS DESTROYED" class="stat-row__label"/>
                <ui:Label name="ships-destroyed-val" text="?" class="stat-row__val"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
